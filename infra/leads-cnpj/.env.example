# This file is only for the isolated public CNPJ database stack. Do not copy
# Prymeira Talk's root .env here and do not put workspace credentials in it.
CNPJ_POSTGRES_DB=cnpj
CNPJ_POSTGRES_USER=cnpj_pipeline
# This is a raw PostgreSQL password; characters such as @ and : are supported.
CNPJ_POSTGRES_PASSWORD=replace_with_a_local_password
CNPJ_POSTGRES_PORT=5436

# Raw Receita downloads are large and intentionally ignored by Git.
CNPJ_RAW_DATA_DIR=./data
CNPJ_DOWNLOAD_WORKERS=1
CNPJ_PROCESS_WORKERS=1
CNPJ_LOADING_STRATEGY=upsert
