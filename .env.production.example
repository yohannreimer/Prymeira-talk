POSTGRES_DB=prymeira_talk
POSTGRES_USER=postgres
PRYMEIRA_TALK_POSTGRES_PASSWORD=troque_esta_senha

CLERK_SECRET_KEY=sk_live_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
VITE_PRYMEIRA_HUB_URL=https://hub.prymeiradigital.com.br

EVOLUTION_API_KEY=replace_me
EVOLUTION_WEBHOOK_SECRET=replace_me
JEV_API_KEY=replace_me
JEV_MODEL=jev-latest
INBOX_TRIAGE_ENABLED=false
INBOX_TRIAGE_PRIMARY=jev
CONTACT_NAME_RECOVERY_ENABLED=true
CHANNEL_WATCHDOG_ENABLED=true
CHANNEL_WATCHDOG_INTERVAL_SECONDS=120
# true = reads and logs only; set false to let the watchdog act
CHANNEL_WATCHDOG_DRY_RUN=true

GHCR_OWNER=yohannreimer
IMAGE_TAG=latest

PUBLIC_TALK_URL=https://talk.prymeiradigital.com.br
PRYMEIRA_ACCOUNT_API_URL=https://hub.prymeiradigital.com.br/api
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW=1 minute
EVOLUTION_API_BASE_URL=https://wsapi.yrdnegocios.com.br
VINCULA_CRM_API_URL=https://vincula.prymeiradigital.com.br/api

# --- Evolution + WAHA + RabbitMQ (docs/operations/waha-rabbit-rollout.md). Everything below is optional and off by default. ---
# WAHA (second connection) and the independent ingress. TALK_AMQP_URL uses the dedicated vhost "talk" and its own user.
WAHA_IMAGE=devlikeapro/waha:chrome-2026.9.1@sha256:23d0344ea7dd3a1190d9ee5c78efebd27eb8bb41bdc6cdc10c2e2ce186ce70d5
WAHA_API_KEY=replace_me_at_least_16_chars
WAHA_WEBHOOK_HMAC_KEY=replace_me_at_least_16_chars
TALK_AMQP_URL=amqp://talk:replace_me@rabbitmq_rabbitmq:5672/talk
INGRESS_WORKSPACE_ALLOWLIST=<workspace id of the test account, never * for the first test>
INGRESS_EVOLUTION_ROUTE_RULE=
INGRESS_RECOVERY_ENABLED=false
WAHA_HISTORY_IMPORT_ENABLED=false
# API switches (prymeira_talk_api). Leave false/empty until the matching rollout step.
# Workspaces that get the integration (comma-separated ids, or *). Empty = nobody: everyone keeps today's behaviour.
WAHA_ROLLOUT_WORKSPACES=
WAHA_ENABLED=false
WAHA_API_BASE_URL=
WAHA_WEBHOOK_BASE_URL=
REALTIME_BRIDGE_ENABLED=false
TALK_MEDIA_STORE_PATH=
EFFECTS_ENABLED=false
EFFECTS_WORKSPACE_ALLOWLIST=
OUTBOUND_ROUTER_ENABLED=false
CHANNEL_HEALTH_MONITOR_ENABLED=false
CANONICAL_HISTORY_IMPORT_ENABLED=false
LEGACY_WEBHOOK_DELEGATED_WORKSPACES=
