# --- Evolution + WAHA + RabbitMQ (docs/operations/waha-rabbit-rollout.md). Everything below is optional and off by default. ---
# WAHA (second connection) and the independent ingress. TALK_AMQP_URL uses the dedicated vhost "talk" and its own user.
WAHA_IMAGE=devlikeapro/waha:chrome-2026.9.1
WAHA_API_KEY=replace_me_at_least_16_chars
WAHA_WEBHOOK_HMAC_KEY=replace_me_at_least_16_chars
TALK_AMQP_URL=amqp://talk:replace_me@rabbitmq_rabbitmq:5672/talk
INGRESS_WORKSPACE_ALLOWLIST=<workspace id of the test account, never * for the first test>
INGRESS_EVOLUTION_ROUTE_RULE=
# API switches (prymeira_talk_api). Leave false/empty until the matching rollout step.
WAHA_ENABLED=false
WAHA_API_BASE_URL=
WAHA_WEBHOOK_BASE_URL=
REALTIME_BRIDGE_ENABLED=false
TALK_MEDIA_STORE_PATH=
EFFECTS_ENABLED=false
EFFECTS_WORKSPACE_ALLOWLIST=
OUTBOUND_ROUTER_ENABLED=false
CHANNEL_HEALTH_MONITOR_ENABLED=false
CANONICAL_HISTORY_IMPORT_ENABLED=false
LEGACY_WEBHOOK_DELEGATED_WORKSPACES=
