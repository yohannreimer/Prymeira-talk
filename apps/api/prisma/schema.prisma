  channelId String @map("channel_id") @db.Uuid
  intentId String @map("intent_id") @db.Uuid
  chatId String @map("chat_id") @db.Uuid
  ordinal Int @default(autoincrement())
  authorityRevision Int @map("authority_revision")
  source Json
  domainFences Json @map("domain_fences")
  proof Json
  createdAt DateTime @default(now()) @map("created_at")
  channel Channel @relation(fields: [workspaceId,channelId], references: [workspaceId,id], onDelete: Cascade)
  intent OutboundIntent @relation(fields: [workspaceId,channelId,intentId], references: [workspaceId,channelId,id], onDelete: Cascade)
  chat CanonicalChat @relation(fields: [workspaceId,channelId,chatId], references: [workspaceId,channelId,id], onDelete: NoAction)
  @@unique([workspaceId,channelId,id])
  @@index([workspaceId,channelId,intentId,ordinal])
  @@map("outbound_recertifications")
}

// Stage 1A transport journal. Immutable receipt/source facts do not grant current
// operational authority. pending_application is an obligation, never completion.
model IngressReceipt {
  id String @id @db.Uuid
  ordinal BigInt @unique @default(autoincrement())
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  stageVersion Int @map("stage_version")
  transportNamespace String @map("transport_namespace")
  source Json
  authentication String
  authenticatedDigest String @map("authenticated_digest")
  rawRef String @map("raw_ref")
  rawDigest String @map("raw_digest")
  eventRef String @map("event_ref")
  eventDigest String @map("event_digest")
  eventCount Int @map("event_count")
  createdAt DateTime @default(now()) @map("created_at")
  channel Channel @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Restrict)
  delivery IngressDelivery?
  application IngressApplication?
  frontier IngressFrontier[]
  attempts IngressPublishAttempt[]
  @@unique([workspaceId, channelId, id])
  @@index([workspaceId, channelId, ordinal])
  @@map("ingress_receipts")
  eventProgress IngressEventProgress[]
}

model IngressDelivery {
  receiptId String @id @db.Uuid @map("receipt_id")
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  state String @default("staged")
  confirmedAt DateTime? @map("confirmed_at")
  consumedAt DateTime? @map("consumed_at")
  leaseToken String? @db.Uuid @map("lease_token")
  leaseUntil DateTime? @map("lease_until")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  failures Int @default(0)
  recoveries Int @default(0)
  lastError String? @map("last_error")
  receipt IngressReceipt @relation(fields: [workspaceId, channelId, receiptId], references: [workspaceId, channelId, id], onDelete: Cascade)
  @@unique([workspaceId, channelId, receiptId])
  @@index([state, nextAttemptAt, leaseUntil])
  @@map("ingress_deliveries")
}

model IngressApplication {
  receiptId String @id @db.Uuid @map("receipt_id")
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  state String @default("pending_application")
  createdAt DateTime @default(now()) @map("created_at")
  // Filled only by the later canonical transaction, not the transport consumer.
  appliedAt DateTime? @map("applied_at")
  receipt IngressReceipt @relation(fields: [workspaceId, channelId, receiptId], references: [workspaceId, channelId, id], onDelete: Cascade)
  @@unique([workspaceId, channelId, receiptId])
  @@index([workspaceId, channelId, state, createdAt])
  @@map("ingress_applications")
}

model IngressFrontier {
  id BigInt @id @default(autoincrement())
  receiptId String @db.Uuid @map("receipt_id")
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  eventIndex Int @map("event_index")
  chatAddress String? @map("chat_address")
  // Exact adapter key only; no text, media, credentials or binary.
  exactKey Json? @map("exact_key")
  kind String
  receipt IngressReceipt @relation(fields: [workspaceId, channelId, receiptId], references: [workspaceId, channelId, id], onDelete: Cascade)
  @@unique([receiptId, eventIndex])
  @@index([workspaceId, channelId, chatAddress, id])
  @@map("ingress_frontiers")
  eventProgress IngressEventProgress?
  @@unique([workspaceId, channelId, receiptId, eventIndex], map: "ingress_frontiers_scope_event_key")
}

model IngressPublishAttempt {
  id String @id @db.Uuid
  receiptId String @db.Uuid @map("receipt_id")
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  destination String
  outcome String @default("pending")
  errorCode String? @map("error_code")
  createdAt DateTime @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")
  receipt IngressReceipt @relation(fields: [workspaceId, channelId, receiptId], references: [workspaceId, channelId, id], onDelete: Cascade)
  @@index([receiptId, createdAt])
  @@map("ingress_publish_attempts")
}

model IngressQuarantine {
  id String @id @db.Uuid
  rawRef String @map("raw_ref")
  rawDigest String @map("raw_digest")
  reason String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("ingress_quarantines")
}


// Private stage 1B progress. Held includes unsupported/incomplete facts; it is not understood content.
model IngressEventProgress {
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  receiptId String @db.Uuid @map("receipt_id")
  eventIndex Int @map("event_index")
  state String
  reason String?
  observationId String? @db.Uuid @map("observation_id")
  actionId String? @db.Uuid @map("action_id")
  conversationId String? @db.Uuid @map("conversation_id")
  messageId String? @db.Uuid @map("message_id")
  result Json
  committedAt DateTime @default(now()) @map("committed_at")
  receipt IngressReceipt @relation(fields: [workspaceId,channelId,receiptId], references: [workspaceId,channelId,id], onDelete: Cascade, map: "ingress_progress_receipt_fkey")
  frontier IngressFrontier @relation(fields: [workspaceId,channelId,receiptId,eventIndex], references: [workspaceId,channelId,receiptId,eventIndex], onDelete: Cascade, map: "ingress_progress_frontier_fkey")
  observation CanonicalObservation? @relation(fields: [workspaceId,channelId,observationId], references: [workspaceId,channelId,id], onDelete: NoAction, map: "ingress_progress_observation_fkey")
  action CanonicalAction? @relation(fields: [workspaceId,channelId,actionId], references: [workspaceId,channelId,id], onDelete: NoAction, map: "ingress_progress_action_fkey")
  conversation Conversation? @relation(fields: [workspaceId,channelId,conversationId], references: [workspaceId,channelId,id], onDelete: NoAction, map: "ingress_progress_conversation_fkey")
  message Message? @relation(fields: [workspaceId,conversationId,messageId], references: [workspaceId,conversationId,id], onDelete: NoAction, map: "ingress_progress_message_fkey")
  effects IngressEffect[]
  @@id([receiptId,eventIndex])
  @@unique([workspaceId,channelId,receiptId,eventIndex], map: "ingress_event_progress_scope_event_key")
  @@index([workspaceId,channelId,state,committedAt], map: "ingress_event_progress_scope_state_idx")
  @@map("ingress_event_progress")
}

// Every row is a real pending obligation. Stage 1C owns handlers and completion.
model IngressEffect {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  receiptId String @db.Uuid @map("receipt_id")
  eventIndex Int @map("event_index")
  conversationId String? @db.Uuid @map("conversation_id")
  messageId String? @db.Uuid @map("message_id")
  kind String
  logicalKey String @map("logical_key")
  cause Json
  frozen Json
  state String @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  progress IngressEventProgress @relation(fields: [workspaceId,channelId,receiptId,eventIndex], references: [workspaceId,channelId,receiptId,eventIndex], onDelete: Cascade, map: "ingress_effects_progress_fkey")
  conversation Conversation? @relation(fields: [workspaceId,channelId,conversationId], references: [workspaceId,channelId,id], onDelete: NoAction, map: "ingress_effects_conversation_fkey")
  message Message? @relation(fields: [workspaceId,conversationId,messageId], references: [workspaceId,conversationId,id], onDelete: NoAction, map: "ingress_effects_message_fkey")
  @@unique([workspaceId,channelId,logicalKey,kind], map: "ingress_effects_scope_logical_kind_key")
  @@index([state,createdAt])
  @@map("ingress_effects")
}

// Private proof of which Message supplies the existing conversation preview cache.
// Writers without proof invalidate this row; legacy cache contents are not inferred.
model ConversationPreviewOwner {
  conversationId String @id @db.Uuid @map("conversation_id")
  workspaceId String @map("workspace_id")
  channelId String @db.Uuid @map("channel_id")
  messageId String @db.Uuid @map("message_id")
  conversation Conversation @relation(fields:[workspaceId,channelId,conversationId], references:[workspaceId,channelId,id], onDelete:Cascade, map:"conversation_preview_owners_conversation_fkey")
  message Message @relation(fields:[workspaceId,conversationId,messageId], references:[workspaceId,conversationId,id], onDelete:Cascade, map:"conversation_preview_owners_message_fkey")
  @@unique([workspaceId,channelId,conversationId],map:"conversation_preview_owners_scope_key")
  @@index([workspaceId,conversationId,messageId],map:"conversation_preview_owners_message_idx")
  @@map("conversation_preview_owners")
}
