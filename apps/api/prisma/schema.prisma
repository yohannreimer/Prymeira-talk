generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  manager
  agent
}

enum ChannelProvider {
  evolution
  meta_cloud
}

enum ChannelStatus {
  disconnected
  connecting
  connected
  failed
}

enum ChannelConnectionProvider {
  evolution
  waha
}

enum ChannelConnectionHealth {
  unknown
  healthy
  degraded
  unhealthy
}

enum ConversationStatus {
  open
  pending
  closed
}

enum InboxReplyDecision {
  needs_reply
  no_reply
  uncertain
}

enum ConversationPriority {
  low
  normal
  high
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  audio
  file
  template
  system
  internal_note
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

enum IntegrationMode {
  simulated
  real
}

enum AutomationStatus {
  enabled
  disabled
}

enum CampaignStatus {
  draft
  scheduled
  sending
  paused
  completed
  failed
  canceled
  needs_attention
}

enum LeadSource {
  google_maps
  receita_federal
}

enum LeadJobStatus {
  queued
  running
  completed
  partial
  failed
}

enum LeadWhatsappStatus {
  unverified
  checking
  available
  unavailable
  failed
}

enum AiAgentStatus {
  active
  inactive
}

enum AiProviderMode {
  prymeira_managed
  workspace_key
}

enum AiKnowledgeSourceType {
  faq
  text
  file
}

enum AiKnowledgeSourceStatus {
  ready
  processing
  failed
}

enum AiAgentSessionStatus {
  active
  paused_by_human
  handoff_requested
  closed
}

enum ConversationFollowupKind {
  qualification
  human_commercial
}

enum ConversationFollowupStatus {
  evaluating
  scheduled
  processing
  review
  sent
  cancelled
  skipped
  expired
  failed
}

enum AiAgentRunStatus {
  completed
  handoff_requested
  failed
  skipped
}

enum AiAgentRunTrigger {
  automation
  manual_test
}

enum AiControlStatus {
  agent_allowed
  human_controlled
}

enum ContactBoardMoveSource {
  manual
  rule
}

enum DepartmentDistributionMode {
  manual
  round_robin
  least_open
}

enum DepartmentMemberRole {
  supervisor
  agent
}

model WorkspaceMirror {
  workspaceId String   @id @map("workspace_id")
  name        String?
  plan        String?
  limits      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workspace_mirrors")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id")
  clerkUserId   String   @map("clerk_user_id")
  role          UserRole @default(agent)
  displayName   String   @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  presenceState String   @default("offline") @map("presence_state")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  assignedConversations Conversation[] @relation("AssignedUserConversations")
  aiControlUpdates      Conversation[] @relation("AiControlUpdatedByConversations")
  sentMessages          Message[]      @relation("UserSentMessages")
  contactNotes          ContactNote[]  @relation("ContactNoteCreatedBy")
  departmentMemberships DepartmentMember[]
  assistantRequests AssistantConversationState[]
  assistantSuggestions AssistantSuggestion[]
  assistantSends AssistantSuggestionSend[]
  sentConversationFollowups ConversationFollowup[] @relation("ConversationFollowupSentBy")
  cancelledConversationFollowups ConversationFollowup[] @relation("ConversationFollowupCancelledBy")

  @@unique([workspaceId, id])
  @@unique([workspaceId, clerkUserId])
  @@index([workspaceId, role])
  @@map("user_profiles")
}

model ConversationInboxTriage {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @map("workspace_id")
  conversationId        String              @map("conversation_id") @db.Uuid
  manualMarkedAt        DateTime?           @map("manual_marked_at")
  manualMarkedById      String?             @map("manual_marked_by_id") @db.Uuid
  lastObservedMessageId String?             @map("last_observed_message_id") @db.Uuid
  anchorMessageId       String?             @map("anchor_message_id") @db.Uuid
  decision              InboxReplyDecision?
  reason                String?
  model                 String?
  analyzedAt            DateTime?           @map("analyzed_at")
  dismissedMessageId    String?             @map("dismissed_message_id") @db.Uuid
  dismissedAt           DateTime?           @map("dismissed_at")
  dueAt                 DateTime?           @map("due_at")
  lockToken             String?             @map("lock_token") @db.Uuid
  lockedAt              DateTime?           @map("locked_at")
  version               Int                 @default(0)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  conversation          Conversation        @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, conversationId])
  @@index([dueAt, lockedAt])
  @@index([workspaceId, manualMarkedAt])
  @@index([workspaceId, decision])
  @@map("conversation_inbox_triage")
}

model Channel {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id")
  provider        ChannelProvider
  providerKey     String          @map("provider_key")
  phoneNumber     String?         @map("phone_number")
  displayName     String?         @map("display_name")
  status          ChannelStatus   @default(disconnected)
  connectionLifecycleGeneration Int @default(0) @map("connection_lifecycle_generation")
  redundancyEnabled Boolean       @default(false) @map("redundancy_enabled")
  activeConnectionId String?       @map("active_connection_id") @db.Uuid
  encryptedConfig Json            @default("{}") @map("encrypted_config")
  followupConfig  Json            @default("{}") @map("followup_config")
  historyImportStatus String?      @map("history_import_status")
  historyImportNextAt DateTime?    @map("history_import_next_at")
  historyImportLeaseToken String?  @map("history_import_lease_token") @db.Uuid
  historyImportLeaseUntil DateTime? @map("history_import_lease_until")
  historyImportAttempts Int        @default(0) @map("history_import_attempts")
  historyImportCompletedAt DateTime? @map("history_import_completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  conversations  Conversation[]
  connections    ChannelConnection[]
  contactBoards  ContactBoardChannel[]
  departmentRules DepartmentChannelRule[]
  leadWhatsappVerifications LeadWhatsappVerification[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, provider, providerKey])
  @@index([workspaceId, status])
  @@index([historyImportStatus, historyImportNextAt])
  @@map("channels")
  ingressReceipts IngressReceipt[]
  canonicalAddresses CanonicalAddress[]
  canonicalChats CanonicalChat[]
  canonicalObservations CanonicalObservation[]
  canonicalAliases CanonicalNativeAlias[]
  @@unique([workspaceId, id, provider])
  outboundIntents OutboundIntent[]
  outboundAttempts OutboundAttempt[]
  outboundResults OutboundResult[]
  outboundBindings OutboundBinding[]
  outboundCorrelations OutboundCorrelation[]
  outboundRecertifications OutboundRecertification[]
}

model ChannelConnection {
  id                  String                    @id @default(uuid()) @db.Uuid
  workspaceId         String                    @map("workspace_id")
  channelId           String                    @map("channel_id") @db.Uuid
  provider            ChannelConnectionProvider
  lifecycleGeneration Int                       @default(0) @map("lifecycle_generation")
  sessionName         String                    @map("session_name")
  status              ChannelStatus             @default(disconnected)
  health              ChannelConnectionHealth    @default(unknown)
  verifiedPhoneNumber String?                   @map("verified_phone_number")
  eligible            Boolean                   @default(false)
  lastCheckedAt       DateTime?                 @map("last_checked_at")
  lastHealthyAt       DateTime?                 @map("last_healthy_at")
  failureStartedAt    DateTime?                 @map("failure_started_at")
  consecutiveFailures Int                      @default(0) @map("consecutive_failures")
  lastError           String?                   @map("last_error")
  connectedAt         DateTime?                 @map("connected_at")
  disconnectedAt      DateTime?                 @map("disconnected_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  channel             Channel                   @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, provider])
  @@unique([workspaceId, provider, sessionName])
  @@index([status, health, lastCheckedAt])
  @@map("channel_connections")
  canonicalObservations CanonicalObservation[]
  canonicalAliases CanonicalNativeAlias[]
  @@unique([workspaceId, channelId, provider, id])
}

model Contact {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id")
  name               String?
  phone              String
  isGroup            Boolean  @default(false) @map("is_group")
  email              String?
  company            String?
  avatarUrl          String?  @map("avatar_url")
  customFields       Json     @default("{}") @map("custom_fields")
  atomicCrmContactId String?  @map("atomic_crm_contact_id")
  atomicCrmLeadId    String?  @map("atomic_crm_lead_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  conversations      Conversation[]
  boardMemberships   ContactBoardMembership[]
  notes              ContactNote[]
  campaignRecipients CampaignRecipient[]
  contactTags        ContactTag[]
  broadcastListMembers BroadcastListMember[]
  leadProvenances    LeadContactProvenance[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, phone])
  @@unique([workspaceId, atomicCrmContactId])
  @@unique([workspaceId, atomicCrmLeadId])
  @@index([workspaceId, name])
  @@map("contacts")
}

model Department {
  id                       String                     @id @default(uuid()) @db.Uuid
  workspaceId              String                     @map("workspace_id")
  name                     String
  description              String?
  routingOrder             Int                        @default(0) @map("routing_order")
  distributionMode         DepartmentDistributionMode @default(manual) @map("distribution_mode")
  businessHours            Json                       @default("{}") @map("business_hours")
  slaFirstResponseMinutes  Int?                       @map("sla_first_response_minutes")
  slaResolutionMinutes     Int?                       @map("sla_resolution_minutes")
  fallbackDepartmentId     String?                    @map("fallback_department_id") @db.Uuid
  lastAssignedMemberId     String?                    @map("last_assigned_member_id") @db.Uuid
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  conversations Conversation[]
  members       DepartmentMember[]
  channelRules  DepartmentChannelRule[]
  fallbackDepartment Department?  @relation("DepartmentFallback", fields: [workspaceId, fallbackDepartmentId], references: [workspaceId, id], onDelete: SetNull)
  fallbackFor         Department[] @relation("DepartmentFallback")

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, fallbackDepartmentId])
  @@map("departments")
}

model DepartmentMember {
  workspaceId  String               @map("workspace_id")
  departmentId String               @map("department_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  role         DepartmentMemberRole @default(agent)
  permissions  Json                 @default("{}")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  department Department  @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: Cascade)
  user       UserProfile @relation(fields: [workspaceId, userId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, departmentId, userId])
  @@index([workspaceId, userId])
  @@map("department_members")
}

model DepartmentChannelRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id")
  departmentId String   @map("department_id") @db.Uuid
  channelId    String   @map("channel_id") @db.Uuid
  enabled      Boolean  @default(true)
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: Cascade)
  channel    Channel    @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId])
  @@index([workspaceId, departmentId])
  @@map("department_channel_rules")
}

model Conversation {
  prospectingOrigin CampaignProspectingReservation?
  id                             String               @id @default(uuid()) @db.Uuid
  workspaceId                    String               @map("workspace_id")
  channelId                      String               @map("channel_id") @db.Uuid
  contactId                      String               @map("contact_id") @db.Uuid
  status                         ConversationStatus   @default(open)
  assignedUserId                 String?              @map("assigned_user_id") @db.Uuid
  departmentId                   String?              @map("department_id") @db.Uuid
  lastMessageAt                  DateTime?            @map("last_message_at")
  lastMessagePreview             String?              @map("last_message_preview")
  lastMessagePreviewAt           DateTime?            @map("last_message_preview_at")
  customerServiceWindowExpiresAt DateTime?            @map("customer_service_window_expires_at")
  unreadCount                    Int                  @default(0) @map("unread_count")
  hiddenUntilReply               Boolean              @default(false) @map("hidden_until_reply")
  priority                       ConversationPriority @default(normal)
  aiControlStatus                AiControlStatus      @default(agent_allowed) @map("ai_control_status")
  aiControlUpdatedAt             DateTime?            @map("ai_control_updated_at")
  aiControlUpdatedById           String?              @map("ai_control_updated_by_id") @db.Uuid
  activeAgentSessionId           String?              @map("active_agent_session_id") @db.Uuid
  createdAt                      DateTime             @default(now()) @map("created_at")
  updatedAt                      DateTime             @updatedAt @map("updated_at")

  assignedUser UserProfile?      @relation("AssignedUserConversations", fields: [workspaceId, assignedUserId], references: [workspaceId, id], onDelete: NoAction)
  aiControlUpdatedBy UserProfile? @relation("AiControlUpdatedByConversations", fields: [workspaceId, aiControlUpdatedById], references: [workspaceId, id], onDelete: NoAction)
  activeAgentSession AiAgentSession? @relation("ActiveAgentSessionConversation", fields: [workspaceId, activeAgentSessionId], references: [workspaceId, id], onDelete: SetNull)
  channel      Channel           @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  contact      Contact           @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  department   Department?       @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: NoAction)
  messages     Message[]
  tags         ConversationTag[]
  contactNotes ContactNote[]     @relation("ContactNoteConversation")
  aiSessions   AiAgentSession[]  @relation("AiAgentSessionConversation")
  aiRuns       AiAgentRun[]
  aiPendingReplies AiAgentPendingReply[]
  followups    ConversationFollowup[]
  improvementSuggestions AiAgentImprovement[]
  assistantState AssistantConversationState?
  assistantSuggestions AssistantSuggestion[]
  inboxTriage ConversationInboxTriage?

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, contactId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, hiddenUntilReply, status, lastMessageAt], map: "conversations_workspace_hidden_status_activity_idx")
  @@index([workspaceId, assignedUserId])
  @@index([workspaceId, aiControlUpdatedById])
  @@index([workspaceId, activeAgentSessionId])
  @@map("conversations")
  canonicalMembers CanonicalChatMember[]
  canonicalOperations CanonicalChat[]
  canonicalIdentities CanonicalMessageIdentity[]
  @@unique([workspaceId, channelId, id])
  outboundIntents OutboundIntent[]
  outboundCorrelations OutboundCorrelation[]
  ingressProgress IngressEventProgress[]
  ingressEffects IngressEffect[]
  previewOwner ConversationPreviewOwner?
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id")
  conversationId    String           @map("conversation_id") @db.Uuid
  providerMessageId String?          @map("provider_message_id")
  providerEventId   String?          @map("provider_event_id")
  direction         MessageDirection
  type              MessageType
  body              String?
  mediaUrl          String?          @map("media_url")
  metadata          Json             @default("{}")
  status            MessageStatus    @default(pending)
  sentByUserId      String?          @map("sent_by_user_id") @db.Uuid
  ingestedAt        DateTime?        @default(now()) @map("ingested_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  sentBy       UserProfile? @relation("UserSentMessages", fields: [workspaceId, sentByUserId], references: [workspaceId, id], onDelete: NoAction)
  assistantInputs AssistantConversationState[]
  assistantSends AssistantSuggestionSend[]
  anchoredFollowups ConversationFollowup[] @relation("ConversationFollowupAnchorMessage")
  improvementSuggestions AiAgentImprovement[] @relation("AiAgentImprovementSourceMessage")

  @@unique([workspaceId, id])
  @@unique([workspaceId, providerEventId])
  @@unique([workspaceId, providerMessageId])
  @@index([workspaceId, conversationId, createdAt])
  @@index([workspaceId, conversationId, ingestedAt(sort: Desc), createdAt(sort: Desc)], map: "messages_assistant_context_order_idx")
  @@map("messages")
  canonicalIdentities CanonicalMessageIdentity[]
  @@unique([workspaceId, conversationId, id])
  outboundIntents OutboundIntent[]
  outboundCorrelations OutboundCorrelation[]
  ingressProgress IngressEventProgress[]
  ingressEffects IngressEffect[]
  ownedConversationPreviews ConversationPreviewOwner[]
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  name        String
  color       String
  useGuide    String   @default("") @map("use_guide")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  conversations       ConversationTag[]
  contactTags        ContactTag[]
  allowedAgents       AiAgentAllowedTag[]
  boardStageTriggers  ContactBoardStageTag[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@map("tags")
}

model ConversationTag {
  workspaceId    String   @map("workspace_id")
  conversationId String   @map("conversation_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  tag          Tag          @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, conversationId, tagId])
  @@index([workspaceId, tagId])
  @@map("conversation_tags")
}

model ContactTag {
  workspaceId String   @map("workspace_id")
  contactId   String   @map("contact_id") @db.Uuid
  tagId       String   @map("tag_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, contactId, tagId])
  @@index([workspaceId, tagId])
  @@map("contact_tags")
}

model LeadList {
  id             String     @id @default(uuid()) @db.Uuid
  workspaceId    String     @map("workspace_id")
  name           String
  source         LeadSource
  criteria       Json       @default("{}")
  totalCount     Int        @default(0) @map("total_count")
  processedCount Int        @default(0) @map("processed_count")
  failedCount    Int        @default(0) @map("failed_count")
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  leads       Lead[]
  jobs        LeadJob[]
  artifacts   LeadArtifact[]
  provenances LeadContactProvenance[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, source])
  @@index([workspaceId, source, createdAt])
  @@index([workspaceId, updatedAt])
  @@map("lead_lists")
}

model Lead {
  id               String     @id @default(uuid()) @db.Uuid
  workspaceId      String     @map("workspace_id")
  listId           String     @map("list_id") @db.Uuid
  source           LeadSource
  sourceExternalId String?    @map("source_external_id")
  sourceDedupeKey  String     @map("source_dedupe_key")
  companyName      String?    @map("company_name")
  tradeName        String?    @map("trade_name")
  cnpj             String?
  cnaePrimary      String?    @map("cnae_primary")
  cnaeSecondary    Json       @default("[]") @map("cnae_secondary")
  category         String?
  address          String?
  city             String?
  state            String?
  postalCode       String?    @map("postal_code")
  phones           Json       @default("[]")
  normalizedPhone  String?    @map("normalized_phone")
  email            String?
  website          String?
  rating           Float?
  reviewCount      Int?       @map("review_count")
  latitude         Float?
  longitude        Float?
  sourceUrl        String?    @map("source_url")
  sourceSnapshot   Json       @default("{}") @map("source_snapshot")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  list                  LeadList                   @relation(fields: [workspaceId, listId, source], references: [workspaceId, id, source], onDelete: Cascade)
  whatsappVerifications LeadWhatsappVerification[]
  contactProvenances    LeadContactProvenance[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, listId, source])
  @@unique([workspaceId, listId, sourceDedupeKey])
  @@index([workspaceId, listId, createdAt])
  @@index([workspaceId, cnpj])
  @@index([workspaceId, normalizedPhone])
  @@index([workspaceId, sourceExternalId])
  @@map("leads")
}

model LeadJob {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id")
  listId         String        @map("list_id") @db.Uuid
  operation      String
  status         LeadJobStatus @default(queued)
  input          Json          @default("{}")
  output         Json          @default("{}")
  errorMessage   String?       @map("error_message")
  attempts       Int           @default(0)
  leaseToken     String?       @map("lease_token") @db.Uuid
  leaseUntil     DateTime?     @map("lease_until")
  startedAt      DateTime?     @map("started_at")
  finishedAt     DateTime?     @map("finished_at")
  idempotencyKey String        @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  list LeadList @relation(fields: [workspaceId, listId], references: [workspaceId, id], onDelete: Cascade)
  artifacts LeadArtifact[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, id, listId])
  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, status, leaseUntil])
  @@index([workspaceId, listId, createdAt])
  @@index([status, createdAt, id])
  @@index([status, leaseUntil])
  @@map("lead_jobs")
}

model LeadArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id")
  listId      String   @map("list_id") @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  kind        String
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  content     Bytes
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  list LeadList @relation(fields: [workspaceId, listId], references: [workspaceId, id], onDelete: Cascade)
  job  LeadJob  @relation(fields: [workspaceId, jobId, listId], references: [workspaceId, id, listId], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, jobId, kind])
  @@index([workspaceId, listId, createdAt])
  @@map("lead_artifacts")
}

model LeadWhatsappVerification {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id")
  leadId          String             @map("lead_id") @db.Uuid
  normalizedPhone String             @map("normalized_phone")
  channelId       String?            @map("channel_id") @db.Uuid
